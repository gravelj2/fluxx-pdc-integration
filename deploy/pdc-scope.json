{
  "_comment": "Hand-maintained. Says WHAT the PDC integration consists of. The installer's Discover/Export methods fetch this file from the repo; deploy/tools/pdc_manifest.rb reads it locally. deploy/pdc-manifest.json is generated from an export and must not be hand-edited.",

  "owned_model_types": {
    "MacModelTypeDynPdcApplicationForm1": { "label": "PDC Integration Map", "folder": "pdc-map/pdc-integration-map" },
    "MacModelTypeDynPdcMappedField1":     { "label": "PDC Mapped Field",    "folder": "pdc-map/pdc-mapped-field" },
    "MacModelTypeDynPdcConsent":          { "label": "PDC Consent",         "folder": "pdc-map/pdc-consent" }
  },

  "grant_request": {
    "model_type": "GrantRequest",
    "folder": "pdc-map/grant-request",
    "method_prefixes": ["PDC ", "PDC_"],
    "attributes": ["pdc_account_exists", "pdc_proposal_id"],
    "shared_state_hooks": [
      { "state": "granted", "field": "unsafe_after_enter", "path": "pdc-map/grant-request/PDC After Enter - Send to PDC.rb" }
    ]
  },

  "markers": {
    "code_start": "###PDC_CODE###",
    "code_end": "###END_PDC_CODE###",
    "element_regex": "<!--\\s*PDC:ELEMENT\\s+id=([\\w-]+)\\s*-->"
  },

  "secret_methods": ["Get PDC Client ID", "Get PDC Client Secret"],

  "excluded_method_patterns": ["^zzz", "^test_method$", "^Testing$"],

  "runtime_option_attributes": [
    "MacModelTypeDynPdcApplicationForm1.opportunity",
    "MacModelTypeDynPdcApplicationForm1.application",
    "MacModelTypeDynPdcMappedField1.fluxx_field",
    "MacModelTypeDynPdcMappedField1.pdc_field"
  ],

  "stencil_volatile_keys": ["uid"],
  "_stencil_profile_keys": "Stencil settings holding UserProfile ids. Masked when hashing (ids differ per instance); checked against the deploy model's pdc_staff_profile instead.",
  "stencil_profile_keys": ["user_profile"],

  "_required_stencil_fields": "Native fields the PDC code reads from the form. Every stencil that holds `with_element` must also have this field (an attribute element) somewhere on it, usually hidden. The account question's proxy dropdown reads and writes grant_request[pdc_account_exists].",
  "required_stencil_fields": [
    { "model_type": "GrantRequest", "attribute": "pdc_account_exists", "with_element": "stencil-container" }
  ],

  "_element_required_config": "Settings every PDC stencil element needs. allow_script lets its JavaScript (and onload handlers) run; strip_html would remove its markup. Fluxx stores these as true/\"1\"/\"0\"; any on/off form is accepted.",
  "element_required_config": { "allow_script": true, "strip_html": false },

  "_placement": "Where Install adds PDC elements that aren't on a form yet, in this order, inside a group with group_label at the bottom of the form: interactive to the form of each theme chosen in PDC Themes, readonly to each chosen in PDC Read-only Themes, dashboard to the first GenericTemplate on the PDC Grantee Profile's dashboard. Admins move them afterwards.",
  "placement": {
    "group_label": "Contribute to the Philanthropy Data Commons (PDC)",
    "interactive": ["portal-style", "fluxx-card-api", "oauth-client", "stencil-container", "floating-panel"],
    "readonly": ["portal-style", "stencil-container-readonly"],
    "dashboard": ["oauth-callback"]
  },

  "stencil_elements": [
    { "id": "portal-style",               "path": "data-explorer/1. portal-style.html",          "host_model_types": ["GrantRequest"],    "include": ["<style", "pdc-floating-panel"],                                   "exclude": [] },
    { "id": "fluxx-card-api",             "path": "data-explorer/2. fluxxCardAPI.html",          "host_model_types": ["GrantRequest"],    "include": ["ACTIVE_CARD_SELECTOR"],                                          "exclude": [] },
    { "id": "oauth-client",               "path": "data-explorer/3. oauth.html",                 "host_model_types": ["GrantRequest"],    "include": ["codeVerifier"],                                                  "exclude": [] },
    { "id": "stencil-container",          "path": "data-explorer/4. pdc-stencil-container.html", "host_model_types": ["GrantRequest"],    "include": ["pdc-auth-container", "pdc-launch-btn", "Review and Manage Consent"], "exclude": [] },
    { "id": "stencil-container-readonly", "path": "data-explorer/4r. pdc-stencil-readonly.html", "host_model_types": ["GrantRequest"],   "include": ["pdc-auth-container", "Review and Manage Consent"],               "exclude": ["pdc-launch-btn"] },
    { "id": "floating-panel",             "path": "data-explorer/5. floating-panel.html",        "host_model_types": ["GrantRequest"],    "include": ["_pdcInitBehavior"],                                              "exclude": [] },
    { "id": "oauth-callback",             "path": "data-explorer/oauth-callback.html",           "host_model_types": ["GenericTemplate"], "include": ["pdc_oauth_result", "window.close"],                               "exclude": ["codeVerifier"] }
  ]
}
