{
  "_comment": "The deploy model's form layout. PDC Bootstrap Deploy Model overwrites the model's existing form stencil with this. No other installer method edits the stencil; they only write field values that this layout renders. Each element is a group (with elements), a field (an attribute on the deploy model), a text element whose text is read from text_path in the repo, or raw: an element exactly as Fluxx stores it (uids are regenerated and filters pointed at the deploy model).",

  "elements": [
    { "group": "Settings", "elements": [
      { "field": "installer_role",      "label": "Installer Role (who can use these buttons)", "required": true },
      { "field": "repo_url",            "label": "Repo URL" },
      { "field": "repo_ref",            "label": "Repo Ref (branch or tag)" },
      { "field": "pdc_event_role",      "label": "Role that can use PDC Integration Map buttons" },
      { "field": "pdc_grantee_profile", "label": "Grantee profile" },
      { "field": "pdc_staff_profile",   "label": "Staff profile" },
      { "field": "grant_request_themes",          "label": "Grant Request themes that show grantees the PDC component" },
      { "field": "grant_request_readonly_themes", "label": "Grant Request themes that show grantees the read-only PDC component" }
    ] },
    { "raw": { "element_type": "spacer", "name": "spacer", "config": { "number_of_lines": "1" }, "visibility": { "visible_show": true, "visible_form": true, "advanced_filter": "1", "advanced_query": "{\"group_type\":\"and\",\"conditions\":[],\"relationship_filter_model_type\":\"MacModelTypeDynPdcInstallConfig\"}", "advanced_sort": "[]" }, "styling": { "alignment": "left" } } },
    { "group": "Results", "elements": [
      { "text_path": "deploy/installer/stencil/Results.liquid" }
    ] },
    { "raw": { "element_type": "spacer", "name": "spacer", "config": { "number_of_lines": "1" }, "visibility": { "visible_show": true, "visible_form": true, "advanced_filter": "1", "advanced_query": "{\"group_type\":\"and\",\"conditions\":[],\"relationship_filter_model_type\":\"MacModelTypeDynPdcInstallConfig\"}", "advanced_sort": "[]" }, "styling": { "alignment": "left" } } },
    { "group": "Snapshots", "elements": [
      { "raw": { "element_type": "component", "name": "model_documents", "label": "Documents", "legacy": null,
                 "config": { "label": "Documents", "disable_add": true, "disable_generate_button": true, "always_allow_uploading": "0",
                             "doc_label": "default", "pdf_snapshot": "0", "enable_docusign": "0" },
                 "visibility": { "visible_show": true, "visible_form": true, "advanced_filter": "1", "advanced_query": "{\"group_type\":\"and\",\"conditions\":[],\"relationship_filter_model_type\":\"MacModelTypeDynPdcInstallConfig\"}", "advanced_sort": "[]" }, "styling": { "alignment": "left" } } }
    ] }
  ]
}
